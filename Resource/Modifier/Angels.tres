[resource]
script = ExtResource("1_7kppm")
modifier_id = "Angels"
modifier_name = "天使の"
explanation = "・この修飾子を持つ武器を所持しているプレイヤーは、アビリティが○○に置換される。
・\"悪魔の\"がついているなら、優先的に天使に置換される。

「悪魔とやらに惑わされないで」

「神とやらに惑わされるなよ」"
